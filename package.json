{
  "name": "one-link",
  "version": "0.1.3-beta.1",
  "description": "Private desktop file sharing over your existing Tailscale network",
  "private": true,
  "author": "Unknown",
  "license": "UNLICENSED",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "test:ui": "node tests/ui-smoke.cjs && node tests/desktop-pair.cjs",
    "pack": "electron-builder --dir --publish never",
    "dist:win": "node scripts/build.cjs"
  },
  "dependencies": {
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.9",
    "selfsigned": "5.5.0",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.onelink.desktop",
    "productName": "ONE LINK",
    "copyright": "© 2026 Unknown",
    "directories": {
      "output": "../build"
    },
    "files": [
      "desktop/**/*",
      "core/**/*",
      "ui/**/*",
      "assets/**/*",
      "THIRD_PARTY_NOTICES.txt",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "portable": {
      "artifactName": "ONE-LINK-${version}-Windows-${arch}.exe"
    },
    "nsis": {
      "artifactName": "ONE-LINK-Setup-${version}-${arch}.exe",
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "ONE LINK"
    }
  }
}
